# ===========================================
# 비트모아 환경변수 설정
# ===========================================
# 이 파일을 복사하여 .env 파일로 저장 후 사용
# cp .env.example .env
# ===========================================

# -------------------------------------------
# 애플리케이션 설정
# -------------------------------------------
# 환경: local, staging, production
SPRING_PROFILES_ACTIVE=local

# Docker 이미지 태그 (배포 시 자동 설정)
TAG=latest

# -------------------------------------------
# JWT 설정
# -------------------------------------------
# 최소 256비트(32자) 이상의 랜덤 문자열 사용
# 예: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random

# 토큰 만료 시간 (밀리초)
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# -------------------------------------------
# PostgreSQL 데이터베이스
# -------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bitmoa
DB_USER=bitmoa
DB_PASSWORD=bitmoa123

# 프로덕션용 (강력한 비밀번호 사용)
# DB_PASSWORD=your-strong-database-password-here

# -------------------------------------------
# Redis 캐시
# -------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 프로덕션용 (비밀번호 설정 권장)
# REDIS_PASSWORD=your-redis-password-here

# -------------------------------------------
# 프론트엔드 설정
# -------------------------------------------
# 개발 환경
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# 프로덕션 환경
# NEXT_PUBLIC_API_URL=https://api.bitmoa.com
# NEXT_PUBLIC_WS_URL=wss://api.bitmoa.com/ws

# -------------------------------------------
# 외부 API (업비트)
# -------------------------------------------
# 업비트 API (인증 필요 시)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# -------------------------------------------
# 배포 서버 설정 (GitHub Actions용)
# -------------------------------------------
# 스테이징 서버
# STAGING_HOST=staging.bitmoa.com
# STAGING_USER=deploy
# STAGING_SSH_KEY=<base64 encoded private key>

# 프로덕션 서버
# PROD_HOST=bitmoa.com
# PROD_USER=deploy
# PROD_SSH_KEY=<base64 encoded private key>

# -------------------------------------------
# 모니터링 및 알림
# -------------------------------------------
# Slack 웹훅 (배포 알림용)
# SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz

# -------------------------------------------
# SSL 인증서 (프로덕션용)
# -------------------------------------------
# Let's Encrypt 또는 자체 인증서 경로
# SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# -------------------------------------------
# 로깅 설정
# -------------------------------------------
LOG_LEVEL=INFO

# 프로덕션에서는 WARN 권장
# LOG_LEVEL=WARN
