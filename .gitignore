# ============================================================
#  Bitmoa — .gitignore
# ============================================================

# ── 환경변수 (절대 커밋 금지) ───────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development

# ── Frontend (Next.js) ──────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/coverage/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# ── Backend (Spring Boot / Gradle) ──────────────────────────
backend/build/
backend/.gradle/
backend/out/
backend/bin/
backend/*.class
backend/HELP.md
!backend/gradle/wrapper/gradle-wrapper.jar
!backend/**/src/main/**/build/
!backend/**/src/test/**/build/

# ── Docker ──────────────────────────────────────────────────
docker-compose.override.yml

# ── IDE ─────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
.factorypath
.classpath
.project
.settings/
.springBeans
.sts4-cache/
.apt_generated/

# ── OS ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 테스트 / 커버리지 ────────────────────────────────────────
coverage/
.nyc_output/
frontend/.jest-cache/

# ── Claude Code / MCP (로컬 전용) ───────────────────────────
.claude/
.mcp.json
